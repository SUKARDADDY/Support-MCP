# Copy to .dev.vars for `wrangler dev`. DEV_SKIP_ACCESS and DEV_SHOW_EMAIL_LINKS
# are honoured ONLY when the request host is localhost / 127.0.0.1; the deployed
# hostname can never satisfy them.
DEV_SKIP_ACCESS=1
SESSION_TTL_MS=120000
# Sign-in pages (/auth/signin, /account). This value is for local use only: make a
# new one for a real deployment with `wrangler secret put AUTH_SECRET`.
AUTH_SECRET=local-dev-only-secret-change-me-0123456789
# Show an emailed sign-in link on the page instead of sending it.
DEV_SHOW_EMAIL_LINKS=1
